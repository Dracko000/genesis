# Genesis runtime configuration (copy to .env and adjust).
# All values have safe local defaults; nothing here is a secret by default.

GENESIS_ENV=development
GENESIS_LOG_LEVEL=INFO

# Storage
GENESIS_DB_PATH=./data/genesis.sqlite3
GENESIS_EVENT_LOG_PATH=./data/events.jsonl
GENESIS_CHECKPOINT_DIR=./checkpoints

# API
GENESIS_API_HOST=127.0.0.1
GENESIS_API_PORT=8000
GENESIS_CORS_ORIGINS=http://localhost:5173

# Research defaults (must remain reproducible; change only with a documented config)
GENESIS_DEFAULT_SEED=7
